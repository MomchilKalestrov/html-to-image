{
    "compilerOptions": {
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "sourceMap": true,
        "declaration": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "noImplicitAny": true,
        "noEmitOnError": true,
        "noUnusedLocals": true,
        "strictNullChecks": true,
        "resolveJsonModule": true,
        "experimentalDecorators": true,
        "jsx": "react",
        "target": "ES2017",
        "lib": [
            "DOM",
            "ES2020"
        ]
    },
    "include": [
        "src/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "**/es",
        "**/lib"
    ]
}